{
  "name": "cncmaps-ts",
  "version": "1.4.0",
  "description": "TypeScript port of CNCMaps — C&C Red Alert 2 / Tiberian Sun map renderer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cncmaps": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:worker": "node scripts/build-worker.mjs",
    "build:all": "npm run build && npm run build:worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "node dist/cli.js",
    "test": "npm run build && node scripts/run-tests.mjs",
    "web": "node scripts/web.mjs",
    "web:serve": "node src/web/server.mjs",
    "prepack": "npm run build:all && node scripts/clean-dist-package.mjs"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ag-psd": "^34.2.3",
    "jpeg-js": "^0.4.4"
  },
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "dist",
    "src/web/server.mjs",
    "src/web/static",
    "scripts/web.mjs",
    "README.md",
    "LICENSE"
  ]
}
