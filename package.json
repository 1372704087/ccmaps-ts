{
  "name": "cncmaps-ts",
  "version": "1.1.0",
  "description": "TypeScript port of CNCMaps — C&C Red Alert 2 / Tiberian Sun map renderer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cncmaps": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:worker": "node scripts/build-worker.mjs",
    "build:all": "npm run build && npm run build:worker",
    "cli": "node dist/cli.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "web": "npm run build:worker && node src/web/server.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
